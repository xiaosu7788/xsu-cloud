# 应用侧环境变量。复制为仓库根目录的 .env 后使用：
#
#   Copy-Item .env.example .env
#
# .env 已被 .gitignore 忽略，不要提交。这里只放占位值。
# 数据库容器本身的变量（POSTGRES_*）在 docker/.env 里，两者不要混。

# ---------------------------------------------------------------- 数据库
# 本地默认端口是 5433：xsu-cloud 的 Compose 把 Postgres 映射到 5433，
# 因为常见的 5432 已被其它项目占用（见 docs/DEPLOYMENT.md 已知约束）。
# 口令必须与 docker/.env 里的 POSTGRES_PASSWORD 一致。
DATABASE_URL=postgres://xsu:change-me-before-first-start@localhost:5433/xsu

# ---------------------------------------------------------------- 鉴权
# 会话与令牌的签名密钥。生成方式（任选其一）：
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
#   openssl rand -base64 32
# 生产必须换掉，且不能与本地一致。
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- OAuth
# 两个提供方各一套凭证。留空时对应按钮不渲染，邮箱密码主路径不受影响。
# GitHub：https://github.com/settings/developers → New OAuth App
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linux.do（Connect）：https://connect.linux.do → 应用管理
#   回调地址填：http://localhost:3000/api/auth/callback/linuxdo
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# Linux.do 的 OAuth 端点在核实前不进代码，只在配置里给（docs/INTEGRATIONS.md 第 7 节）。
# 三个端点在启用 Linux.do 时必须同时填，否则启动即报错。
# 从 https://connect.linux.do 的应用管理页 / 该站 OIDC 发现文档取得，不要照抄二手资料。
LINUXDO_AUTHORIZATION_URL=
LINUXDO_TOKEN_URL=
LINUXDO_USERINFO_URL=

# ---------------------------------------------------------------- 队列（Redis）
# M2 起是必填项：注册验证邮件由 worker 经队列发送，Redis 不可达时注册路径会失败。
# 本地用 docker/docker-compose.yml 里的 redis 服务（宿主端口 6379，与 docker/.env 的
# REDIS_PORT 一致）。生产用 rediss:// 并带上访问口令。
# 不给默认值兜底的理由与密钥相同：默认的 localhost:6379 在开发机上恰好能用，
# 到了生产会静默指向一个不存在的实例。
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- 工具执行
# 单用户每小时的工具执行上限。留空用领域层默认值（packages/core/src/tools/run-tool.ts）。
# 注意「留空」与「写 0」是两回事：写 0 表示关闭工具执行，不是恢复默认值。
TOOL_RUN_QUOTA_PER_HOUR=

# 运行历史的保留天数。留空用领域层默认值；超出保留期的记录由 worker 的每日清理任务删除。
TOOL_RUN_RETENTION_DAYS=
