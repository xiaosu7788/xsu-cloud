# 复制为 docker/.env 后使用；docker/.env 已被 .gitignore 忽略，不要提交。
#
#   Copy-Item docker/.env.example docker/.env
#
# 下面的口令是占位值，本地开发可以保持不动；任何对外可达的环境都必须换掉。

POSTGRES_USER=xsu
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_DB=xsu

# 端口只在本地占用冲突时才需要改。
POSTGRES_PORT=5432
REDIS_PORT=6379

# 应用侧连接串（M2 起由 packages/db 与 drizzle-kit 使用），供参考：
# DATABASE_URL=postgres://xsu:change-me-before-first-start@localhost:5432/xsu
# REDIS_URL=redis://localhost:6379
